# Generated by `generate-third-party` and committed by a pipeline on every
# branch, so any two branches that have run one differ here. Merged by keeping
# the copy of the branch being merged into; the next pipeline recomputes the
# keys and commits whatever the merge actually changed. See
# cicd/set_generated_file_merge_driver.sh, which configures the driver.
THIRD-PARTY.md merge=keep-ours
THIRD-PARTY.lock merge=keep-ours
Frontend/public/THIRD-PARTY.md merge=keep-ours
