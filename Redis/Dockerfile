# Image version
ARG REDIS_IMAGE_VERSION="7.4.11-alpine3.21"
ARG REDIS_IMAGE_DIGEST="sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499"

ARG DOCKER_REGISTRY="docker.io"
FROM ${DOCKER_REGISTRY}/redis:${REDIS_IMAGE_VERSION}@${REDIS_IMAGE_DIGEST}

CMD [ "redis-server", "/usr/local/etc/redis/redis.conf" ]

EXPOSE 6379
