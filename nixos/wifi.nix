# The appliance's optional access point.
#
# Off unless the image was built with `build-appliance-image --wifi`, in which
# case the box brings up its own WPA-protected network and bridges it onto the
# same segment as the wired port. A visitor who joins over the air lands in the
# same DHCP pool, behind the same resolver, at the same https://frontend.loom as
# one who plugs a cable in -- see network.nix, which owns the bridge.
#
# What this costs is stated plainly in Documentation/appliance.md and is worth
# repeating here: Loom has no user management and its frontend is not an
# authentication boundary, so with the radio on, the passphrase below is the
# only thing between the indexed corpus and everyone in range of the box.
#
# The credentials are generated once, by the build script, and baked into the
# closure. They are therefore world-readable in /nix/store and present on the
# USB stick. That is a deliberate trade: the operator learns the SSID and the
# passphrase from `build-appliance-image` before the box has ever been booted.
{
  config,
  lib,
  pkgs,
  enableWifi,
  wifiSsid,
  wifiPsk,
  wifiCountry,
  wifiInterface,
  ...
}:
let
  cfg = config.loom;

  # Same reasoning as network.nix's `loom0`: the appliance never refers to a
  # kernel-assigned name. udev renames whatever the platform matches to this,
  # and hostapd, the bridge and the banner all pin to it.
  wifiIface = "loomwl0";

  # `wifiInterface` is the escape hatch, exactly like `loomInterface` next door:
  # empty means "use the platform's match".
  wifiMatch =
    if wifiInterface != "" then { OriginalName = wifiInterface; } else cfg.platform.wifiMatch;

  isRun = cfg.mode == "run";
  active = cfg.wifi.enable && isRun;
in
{
  options.loom.wifi = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = enableWifi;
      description = ''
        Run an access point on the box's own radio, bridged onto the wired
        segment. Set by `build-appliance-image --wifi`; off in every other image,
        which is what keeps radios.nix's blanket radio block in force.
      '';
    };

    ssid = lib.mkOption {
      type = lib.types.str;
      default = wifiSsid;
      description = "Network name to advertise. Generated by the build script.";
    };

    psk = lib.mkOption {
      type = lib.types.str;
      default = wifiPsk;
      description = ''
        The WPA passphrase. Generated by the build script from the same alphabet
        as the LUKS recovery passphrase (installer/loom_installer/install.py), which is
        not a coincidence: that alphabet excludes `\ ; : , "`, the exact set the
        `WIFI:` URI on the login screen would otherwise have to escape, and a
        backslash in an issue file is eaten by agetty before anyone sees it.
      '';
    };

    country = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = if wifiCountry == "" then null else wifiCountry;
      description = ''
        ISO 3166-1 country code, from `--wifi-country`. Null keeps the radio on
        2.4GHz under regulatory domain 00, which is legal everywhere; setting it
        moves the AP to 5GHz UNII-1.

        This is not a formality that 5GHz could be talked out of. Under domain 00
        every 5GHz sub-band is flagged NO-IR -- No Initiating Radiation -- which
        permits joining a network someone else started but forbids beaconing, so
        hostapd cannot bring an AP up at all. `iw reg get` shows it on any box.
      '';
    };

    interface = lib.mkOption {
      type = lib.types.str;
      default = wifiIface;
      readOnly = true;
      description = "The radio's name after udev has renamed it.";
    };

    bridge = lib.mkOption {
      type = lib.types.str;
      default = "loombr0";
      readOnly = true;
      description = ''
        The bridge carrying both the radio and the wired NIC. network.nix puts
        the appliance address on this instead of on loom0 when the AP is enabled.
      '';
    };
  };

  config = lib.mkMerge [
    {
      # What radios.nix gates the 802.11 stack on. Read from the option rather
      # than from the `enableWifi` argument above, because a test node turns the
      # access point on by setting the option and never touches the build flag --
      # and a test node that sets it is in run mode, so `active` holds there too.
      #
      # Mode-gated, like everything that *uses* the radio. In setup mode nothing
      # can run an access point and nothing ever calls `rfkill unblock wifi`, so
      # relaxing the block there only left cfg80211/mac80211 loadable, skipped the
      # `install cfg80211 .../false` chokepoint and had loom-rfkill-block block
      # `bluetooth` instead of `all` -- on the one boot the box spends on somebody
      # else's LAN. "`--wifi` opts a box into an access point, not into a radio
      # free-for-all" is this module's own stated policy.
      loom.radios.allowWifi = active;

      assertions = [
        {
          assertion = cfg.wifi.enable -> wifiMatch != null;
          message =
            "nixos: --wifi was given, but platform '${cfg.platform.id}' declares no wifiMatch, "
            + "so there is no radio to run an access point on. Pass --wifi-interface <name> to "
            + "name one explicitly, or build this platform without --wifi.";
        }
        {
          # hostapd's own assertions would catch a short one, but only after a
          # full closure evaluation and with a message about hostapd rather than
          # about the flag the operator actually passed.
          assertion = cfg.wifi.enable -> (builtins.stringLength cfg.wifi.psk >= 8);
          message = "nixos: --wifi-psk must be at least 8 characters (WPA minimum).";
        }
        {
          assertion = cfg.wifi.enable -> cfg.wifi.ssid != "";
          message = "nixos: --wifi requires a non-empty --wifi-ssid.";
        }
        {
          # Not style policing. Both strings are interpolated into the `WIFI:`
          # URI the login screen renders as a QR code, a format that reserves
          # `\ ; : , "` and escapes them with a backslash -- and a backslash in
          # an issue file is consumed by agetty as an escape of its own before it
          # reaches the screen (box.nix). Restricting the alphabet is what lets
          # that interpolation stay escape-free and correct. The build script
          # generates from a narrower set still; this catches a hand-passed
          # --wifi-ssid or --wifi-psk.
          assertion =
            cfg.wifi.enable
            -> (
              builtins.match "[A-Za-z0-9_-]+" cfg.wifi.ssid != null
              && builtins.match "[A-Za-z0-9_-]+" cfg.wifi.psk != null
            );
          message =
            "nixos: --wifi-ssid and --wifi-psk may only contain letters, digits, '-' and '_'. "
            + "Anything else cannot be put on the console QR code without an escape the console eats.";
        }
      ];
    }

    # -------------------------------------------------------------------------
    # The access point. Run mode only.
    #
    # Setup mode is an ordinary DHCP client that needs real internet exactly once
    # (network.nix) and runs no dnsmasq, so an AP there would advertise a network
    # that resolves nothing. The installer stick never imports this module at all.
    # -------------------------------------------------------------------------
    (lib.mkIf active {
      # Same trick, and the same caveat, as network.nix's rename of the wired
      # NIC: .link files are applied by udev whether or not networkd runs.
      systemd.network.links."10-${wifiIface}" = {
        matchConfig = wifiMatch;
        linkConfig.Name = wifiIface;
      };

      services.hostapd = {
        enable = true;
        radios.${wifiIface} = {
          # 2.4GHz unless a country code says otherwise. Slower, but channel
          # 1-11 is the only thing regulatory domain 00 lets an AP beacon on --
          # see `country` above.
          band = if cfg.wifi.country == null then "2g" else "5g";
          # A fixed channel rather than ACS (channel = 0): automatic channel
          # selection needs the driver to support ACS surveys, and a box that
          # silently fails to pick a channel is indistinguishable from one whose
          # radio does not do AP mode. 6 is the middle non-overlapping 2.4GHz
          # channel; 36 is the bottom of UNII-1, which is non-DFS everywhere it
          # is allocated at all, so the AP never waits out a radar CAC.
          channel = if cfg.wifi.country == null then 6 else 36;
          countryCode = cfg.wifi.country;

          # 802.11n. Visitors are uploading documents into a search engine, and
          # 802.11g alone would cap that near 20 Mbit/s.
          wifi4.enable = true;

          networks.${wifiIface} = {
            ssid = cfg.wifi.ssid;

            # Transition mode, not plain WPA3. The point of this feature is that
            # an unknown visitor's phone joins by scanning a QR code off the
            # monitor, and a WPA3-only AP silently excludes anything too old to
            # do SAE. hostapd's own default of ieee80211w = 1 keeps management
            # frame protection optional, which is what lets both generations
            # associate; forcing it would put the WPA2 half back out.
            authentication = {
              mode = "wpa3-sae-transition";
              # Both halves are required in transition mode. Already in the
              # store by construction -- see the header.
              wpaPassword = cfg.wifi.psk;
              saePasswords = [ { password = cfg.wifi.psk; } ];
            };

            # Clients have no reason to talk to each other -- every one of them
            # is here to reach the box -- and a room full of strangers' laptops
            # on one segment is not something to arrange on purpose.
            apIsolate = true;

            # This tells hostapd which bridge to use, but does NOT add the
            # interface to the bridge. That is done by loom-wifi-bridge-attach
            # below, because hostapd's bridge integration is driver-dependent
            # and some drivers (including mt7925e on the Spark) do not
            # automatically enslave the interface.
            settings.bridge = cfg.wifi.bridge;
          };
        };
      };

      # hostapd is handed `bridge=` in its own configuration above, and nixpkgs
      # binds it to the radio's .device unit and nothing else. So it can be told
      # to join a bridge that has not been created yet, which the driver reports
      # -- if at all -- as a failure to configure the BSS.
      #
      # `wants` as well as `after`, for the reason loom-wifi-bridge-attach gives
      # below: the netdev unit is already pulled in by network.target, but this
      # file should not depend on another module's `wantedBy` for its own
      # ordering to be anything other than vacuous.
      systemd.services.hostapd = {
        after = [ "${cfg.wifi.bridge}-netdev.service" ];
        wants = [ "${cfg.wifi.bridge}-netdev.service" ];
      };

      # Explicitly add the WiFi interface to the bridge. hostapd's settings.bridge
      # only tells the daemon which bridge to use - it does not guarantee the
      # interface is added, especially on drivers like mt7925e (Spark) that do not
      # support automatic bridge enslavement. Without this, WiFi clients cannot
      # reach DHCP or the Loom frontend.
      #
      # Safe on all platforms: if the interface is already bridged (EVO-X2's
      # MediaTek card), the command succeeds silently. If it is not (Spark's
      # mt7925e), it is added.
      systemd.services.loom-wifi-bridge-attach = {
        description = "Attach the WiFi radio to the appliance bridge";
        wantedBy = [ "network.target" ];
        # `wants` as well as `after`, and the netdev unit is the reason. Ordering
        # alone pulls nothing into the transaction: it says "if both start, this
        # one goes second", so when the bridge was not already being started this
        # unit ran first and `ip` answered `argument "loombr0" is wrong: Device
        # does not exist`. Measured on a Spark -- it and network.nix's wired
        # counterpart failed in the same 50 ms, leaving an access point that was
        # broadcasting and attached to nothing.
        #
        # `wants`, not `requires` or `bindsTo`: a bridge that failed to appear
        # should leave this unit failed and visible, not cascade into whatever
        # else wanted it.
        wants = [ "${cfg.wifi.bridge}-netdev.service" ];
        # `systemd-udev-settle.service` is not on this nixpkgs pin, so naming it
        # here ordered nothing; the two real edges are the netdev and hostapd.
        after = [
          "${cfg.wifi.bridge}-netdev.service"
          "hostapd.service"
        ];
        # As network.nix's wired counterpart: before the address, and before
        # network.target, which is what every unit that assembles an interface
        # does upstream. The second edge has a cost worth stating -- this unit is
        # `after` hostapd, so network.target now waits for the radio as well as
        # for the bridge. Bounded: hostapd `bindsTo` the radio's .device unit, so
        # a box with no radio starts no hostapd job and nothing waits on it, and
        # a hostapd that fails releases the ordering when its job completes.
        before = [
          "network-addresses-${cfg.wifi.bridge}.service"
          "network.target"
        ];
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
        };
        path = [ pkgs.iproute2 ];
        # Idempotent: the master check reads the kernel's view, so a re-run on a
        # radio hostapd already enslaved does nothing. Spelled as a script rather
        # than a one-line ExecStart so that each failure can say which device was
        # missing -- `ip`'s own message names the bridge whichever argument was
        # wrong, which cost an evening once.
        script = ''
          if [ ! -e /sys/class/net/${wifiIface} ]; then
            echo "[!] ${wifiIface} does not exist; loom-wifi-check reports the radio."
            exit 0
          fi
          if [ ! -e /sys/class/net/${cfg.wifi.bridge} ]; then
            echo "[!] bridge ${cfg.wifi.bridge} does not exist -- the radio stays unbridged,"
            echo "[!] so clients associate and then reach nothing."
            exit 1
          fi
          if ip link show ${wifiIface} | grep --quiet "master ${cfg.wifi.bridge}"; then
            echo "[*] ${wifiIface} is already a port of ${cfg.wifi.bridge}."
            exit 0
          fi
          ip link set dev ${wifiIface} master ${cfg.wifi.bridge}
          echo "[*] Attached ${wifiIface} to ${cfg.wifi.bridge}."
        '';
      };

      # The unit that makes an access point possible at all.
      #
      # radios.nix asks the kernel to register every rfkill switch soft-blocked
      # (`options rfkill default_state=0`), which is what leaves no window on a
      # box that is not meant to have a radio. On this one it means the radio
      # arrives blocked and stays blocked until this runs, and hostapd will not
      # unblock one itself: it just fails to bring the interface up. Firmware
      # that hands over a soft-blocked card is released by the same call.
      #
      # `wantedBy` names hostapd as well as multi-user.target, so the ordering
      # below also holds for a `systemctl restart hostapd` rather than only for
      # the boot transaction. `rfkill unblock` is a change-all operation: it
      # moves the kernel's default for the type, so a radio that enumerates
      # after this has run is unblocked too.
      systemd.services.loom-rfkill-unblock-wifi = {
        description = "Release the soft block on the appliance radio";
        wantedBy = [
          "multi-user.target"
          "hostapd.service"
        ];
        before = [ "hostapd.service" ];
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
          ExecStart = "${pkgs.util-linux}/bin/rfkill unblock wifi";
          # Nothing to unblock is the normal case, and rfkill exits non-zero for
          # it exactly as it does for `block all` in radios.nix.
          SuccessExitStatus = [
            0
            1
          ];
        };
      };

      # ---------------------------------------------------------------------
      # Say so on the console when the AP did not come up.
      #
      # This matters more here than for the wired NIC. hostapd BindsTo the
      # radio's .device unit, so a wrong match, a missing card or a radio that
      # cannot do AP mode all produce the same silent outcome: hostapd never
      # starts, no error reaches anyone, and the login screen goes on printing an
      # SSID and a QR code for a network that does not exist. On a box with no
      # sshd, the issue file is the only place that can be corrected.
      #
      # Same shape as network.nix's loom-network-check, for the same reasons --
      # including the ordering against getty-pre.target and the refusal to fail.
      # ---------------------------------------------------------------------
      systemd.services.loom-wifi-check = {
        description = "Warn when the appliance access point is missing";
        wantedBy = [ "multi-user.target" ];
        # As above: `systemd-udev-settle.service` does not exist on this pin.
        after = [ "hostapd.service" ];
        # `before` names getty-pre.target as well as loom.service: `wants` pulls
        # the target into the transaction but orders nothing against it, and the
        # fragment written below is the one thing that corrects a login banner
        # still printing an SSID and a QR code for an access point that never
        # came up. See network.nix's loom-network-check.
        wants = [ "getty-pre.target" ];
        before = [
          "loom.service"
          "getty-pre.target"
        ];
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
          StandardOutput = "journal";
          StandardError = "journal";
        };
        path = [
          pkgs.coreutils
          config.systemd.package
          config.loom.banner.fragment
        ];
        script = ''
          LOOM_WIFI_INTERFACE=${lib.escapeShellArg wifiIface}

          ${builtins.readFile ./scripts/loom_wifi_check.sh}'';
      };
    })
  ];
}
