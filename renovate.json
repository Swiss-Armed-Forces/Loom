{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Comprehensive Renovate configuration for Loom - a multi-technology project with Frontend (TypeScript/React), Backend (Python/Poetry), Docker, and Helm",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separatePatchReleases",
    "security:openssf-scorecard",
    "workarounds:all"
  ],
  "timezone": "UTC",
  "schedule": ["before 6am on sunday"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "branchPrefix": "renovate/",
  "labels": ["dependencies", "renovate"],
  "enabledManagers": [
    "npm",
    "poetry",
    "dockerfile",
    "helm-values",
    "helmv3",
    "gitlabci",
    "custom.regex"
  ],
  "poetry": {
    "versioning": "pep440"
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "prCreation": "immediate",
    "labels": ["security", "vulnerability"],
    "groupName": null,
    "groupSlug": null
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"],
    "commitMessageAction": "lock file maintenance",
    "branchTopic": "lock-file-maintenance"
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["Frontend/**"],
      "groupName": "Frontend Dependencies",
      "matchDepTypes": ["dependencies", "devDependencies"],
      "prPriority": 5,
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["poetry"],
      "matchFileNames": ["backend/**", "integrationtest/**"],
      "groupName": "Backend Dependencies",
      "prPriority": 4,
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["poetry"],
      "matchFileNames": ["pyproject.toml"],
      "groupName": "Root Dev Dependencies",
      "prPriority": 3,
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["poetry"],
      "matchFileNames": ["pyproject.toml"],
      "postUpgradeTasks": {
        "commands": ["poetry lock --no-update"],
        "fileFilters": ["poetry.lock"],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": ["poetry"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "matchManagers": ["dockerfile", "gitlabci"],
      "groupName": "Docker images",
      "prPriority": 3,
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["docker.io/chrislusf/seaweedfs"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)_(?<compatibility>full)$"
    },
    {
      "matchFileNames": ["backend/common/pyproject.toml"],
      "postUpgradeTasks": {
        "commands": [
          "poetry lock --no-update --directory backend/api",
          "poetry lock --no-update --directory backend/worker",
          "poetry lock --no-update --directory backend/crawler",
          "poetry lock --no-update --directory integrationtest",
          "poetry lock --no-update"
        ],
        "fileFilters": [
          "backend/api/poetry.lock",
          "backend/worker/poetry.lock",
          "backend/crawler/poetry.lock",
          "integrationtest/poetry.lock",
          "poetry.lock"
        ],
        "executionMode": "update"
      }
    },
    {
      "matchUpdateTypes": ["major"],
      "prPriority": 10,
      "schedule": ["before 6am on the first day of the month"]
    },
    {
      "matchDepPrefixes": ["devenv-"],
      "enabled": true,
      "groupName": "devenv update reminder",
      "schedule": ["before 6am on the first day of the month"],
      "labels": ["nix", "devenv"],
      "prPriority": 2,
      "prBodyNotes": [
        "One or more devenv inputs have newer commits. Run `devenv update` and commit the updated `devenv.lock`."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update package manager versions in package.json",
      "managerFilePatterns": ["/(^|/)package\\.json$/"],
      "matchStrings": [
        "\"packageManager\":\\s*\"(?<depName>pnpm)@(?<currentValue>\\S+)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track devenv input updates to notify when devenv update should be run",
      "managerFilePatterns": ["/(^|/)devenv\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+packageName=(?<packageName>\\S+)\\s+currentValue=(?<currentValue>\\S+)\\s+currentDigest=(?<currentDigest>[a-f0-9]+)"
      ]
    }
  ],
  "hostRules": [
    {
      "matchHost": "registry.npmjs.org",
      "concurrentRequestLimit": 10
    },
    {
      "matchHost": "pypi.org",
      "concurrentRequestLimit": 10
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.git/**",
    "**/logs/**",
    "**/log/**",
    "**/out/**"
  ],
  "allowedCommands": [
    "^poetry lock --no-update"
  ],
  "rebaseWhen": "never",
  "automergeSchedule": ["before 6am"],
  "platformAutomerge": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "dependencyDashboardApproval": false,
  "dependencyDashboardAutoclose": true,
  "commitBodyTable": true,
  "prBodyTemplate": "{{{header}}}{{{table}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}"
}
