# Ollama Runtime Image (GPU-agnostic)
# Contains Ollama server + wrapper, NO models
# Build with GPU_VARIANT=nvidia or GPU_VARIANT=rocm

ARG GPU_VARIANT="nvidia"
ARG DOCKER_REGISTRY="docker.io"

# Must stay in lockstep with ollama/Dockerfile.models: a model pulled by 0.40 or
# newer is written in a manifest format a pre-0.40 runtime cannot read.

# NVIDIA configuration
ARG OLLAMA_IMAGE_VERSION_NVIDIA="0.40.4"
ARG OLLAMA_IMAGE_DIGEST_NVIDIA="sha256:926d40fd6eeeebd346b5c358a63de2a10ec995371cd93dd22f1843200694b1a6"

# ROCm configuration - the tag carries its own -rocm suffix so that the pin names
# the image it resolves to, digest included
ARG OLLAMA_IMAGE_VERSION_ROCM="0.40.4-rocm"
ARG OLLAMA_IMAGE_DIGEST_ROCM="sha256:86f96f13977da6a2f4819962fc040c01987eff2d14660441b247ff4e48bcf459"

# Select base image based on GPU_VARIANT
FROM ${DOCKER_REGISTRY}/ollama/ollama:${OLLAMA_IMAGE_VERSION_NVIDIA}@${OLLAMA_IMAGE_DIGEST_NVIDIA} AS nvidia
FROM ${DOCKER_REGISTRY}/ollama/ollama:${OLLAMA_IMAGE_VERSION_ROCM}@${OLLAMA_IMAGE_DIGEST_ROCM} AS rocm

# Select the appropriate stage based on GPU_VARIANT
FROM ${GPU_VARIANT}

# Python for wrapper script
ARG PYTHON_VERSION="3.12.*"
RUN set -exu \
  && apt-get -y update \
  && apt-get -y install --no-install-recommends python3=${PYTHON_VERSION} \
  && rm -rf /var/lib/apt/lists/*

COPY ollama_wrapper.py /bin/ollama_wrapper.py

# Runtime configuration
ENV OLLAMA_HOST="0.0.0.0"
ENV OLLAMA_DEBUG=1
ENV OLLAMA_NO_CLOUD=1

ENTRYPOINT ["/bin/ollama_wrapper.py", "entry"]
CMD ["serve"]
